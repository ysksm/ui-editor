{
  "name": "@ui-editor/poc-codegen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "poc-codegen": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen": "node dist/cli.js",
    "embed": "node scripts/embed-templates.mjs",
    "snapshots:update": "vitest run -u",
    "build:example": "pnpm run build && node scripts/build-example.mjs"
  },
  "dependencies": {
    "@ui-editor/poc-model": "workspace:*",
    "@ui-editor/runtime": "workspace:*",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@ui-editor/poc-datastore": "workspace:*"
  }
}
