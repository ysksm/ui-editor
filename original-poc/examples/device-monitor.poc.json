{
  "schemaVersion": "poc-0",
  "name": "機器の設定＆モニタリング",
  "description": "#1 の題材を poc-0 で書いたもの。データは機器の下に設定・メトリクス・アラームを入れ子で持つ。",
  "entry": "dashboard",
  "entities": [
    {
      "id": "Device",
      "name": "機器",
      "primaryKey": "id",
      "displayField": "name",
      "fields": [
        {
          "id": "id",
          "type": "id"
        },
        {
          "id": "name",
          "type": "string",
          "name": "名前",
          "required": true
        },
        {
          "id": "model",
          "type": "string",
          "name": "型番"
        },
        {
          "id": "status",
          "type": "enum",
          "name": "状態",
          "default": "online",
          "values": [
            "online",
            "offline",
            "warning"
          ]
        },
        {
          "id": "ipAddress",
          "type": "string",
          "name": "IP アドレス",
          "format": "ipv4"
        },
        {
          "id": "firmware",
          "type": "string",
          "name": "ファームウェア"
        },
        {
          "id": "settings",
          "type": "children",
          "name": "設定",
          "entity": "DeviceSettings",
          "cardinality": "one"
        },
        {
          "id": "metrics",
          "type": "children",
          "name": "メトリクス",
          "entity": "Metric"
        },
        {
          "id": "alarms",
          "type": "children",
          "name": "アラーム",
          "entity": "Alarm"
        }
      ]
    },
    {
      "id": "DeviceSettings",
      "name": "機器設定",
      "primaryKey": "id",
      "displayField": "ip",
      "fields": [
        {
          "id": "id",
          "type": "id"
        },
        {
          "id": "dhcp",
          "type": "boolean",
          "name": "DHCP",
          "default": false
        },
        {
          "id": "ip",
          "type": "string",
          "name": "IP アドレス",
          "format": "ipv4"
        },
        {
          "id": "subnet",
          "type": "string",
          "name": "サブネットマスク",
          "format": "ipv4"
        },
        {
          "id": "gateway",
          "type": "string",
          "name": "ゲートウェイ",
          "format": "ipv4"
        },
        {
          "id": "temperatureMax",
          "type": "number",
          "name": "温度の上限（℃）",
          "min": 0,
          "max": 120
        },
        {
          "id": "cpuMax",
          "type": "number",
          "name": "CPU 使用率の上限（%）",
          "min": 0,
          "max": 100
        },
        {
          "id": "pollingIntervalSec",
          "type": "number",
          "name": "ポーリング間隔（秒）",
          "min": 5,
          "max": 3600
        }
      ]
    },
    {
      "id": "Metric",
      "name": "メトリクス",
      "primaryKey": "id",
      "displayField": "timestamp",
      "fields": [
        {
          "id": "id",
          "type": "id"
        },
        {
          "id": "timestamp",
          "type": "date",
          "name": "日時",
          "required": true,
          "format": "datetime"
        },
        {
          "id": "temperature",
          "type": "number",
          "name": "温度（℃）"
        },
        {
          "id": "cpu",
          "type": "number",
          "name": "CPU 使用率（%）",
          "min": 0,
          "max": 100
        },
        {
          "id": "trafficMbps",
          "type": "number",
          "name": "通信量（Mbps）",
          "min": 0
        }
      ]
    },
    {
      "id": "Alarm",
      "name": "アラーム",
      "primaryKey": "id",
      "displayField": "message",
      "fields": [
        {
          "id": "id",
          "type": "id"
        },
        {
          "id": "level",
          "type": "enum",
          "name": "レベル",
          "required": true,
          "values": [
            "info",
            "warn",
            "error"
          ]
        },
        {
          "id": "message",
          "type": "string",
          "name": "内容",
          "required": true
        },
        {
          "id": "occurredAt",
          "type": "date",
          "name": "発生日時",
          "format": "datetime"
        },
        {
          "id": "acknowledged",
          "type": "boolean",
          "name": "確認済み",
          "default": false
        }
      ]
    }
  ],
  "state": {},
  "screens": [
    {
      "id": "dashboard",
      "name": "ダッシュボード",
      "path": "/",
      "root": {
        "id": "page",
        "type": "Box",
        "props": {
          "direction": "column",
          "gap": 16
        },
        "children": [
          {
            "id": "title",
            "type": "Text",
            "props": {
              "text": "ダッシュボード",
              "variant": "title"
            }
          },
          {
            "id": "alarmsTitle",
            "type": "Text",
            "props": {
              "text": "未確認のアラーム"
            }
          },
          {
            "id": "alarms",
            "type": "Table",
            "props": {
              "columns": [
                {
                  "header": "レベル",
                  "value": "{{ row.level }}"
                },
                {
                  "header": "内容",
                  "value": "{{ row.message }}"
                },
                {
                  "header": "発生日時",
                  "value": "{{ row.occurredAt }}"
                }
              ],
              "rows": "{{ data.Alarm.filter((a) => !a.acknowledged) }}"
            }
          },
          {
            "id": "toDevices",
            "type": "Button",
            "props": {
              "label": "機器一覧へ"
            },
            "events": {
              "click": [
                {
                  "type": "navigate",
                  "to": "devices"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "devices",
      "name": "機器一覧",
      "kind": "list",
      "entity": "Device",
      "path": "/devices",
      "root": {
        "id": "page",
        "type": "Box",
        "props": {
          "direction": "column",
          "gap": 16
        },
        "children": [
          {
            "id": "title",
            "type": "Text",
            "props": {
              "text": "機器一覧",
              "variant": "title"
            }
          },
          {
            "id": "toolbar",
            "type": "Box",
            "props": {
              "direction": "row",
              "gap": 8
            },
            "children": [
              {
                "id": "edit",
                "type": "Button",
                "props": {
                  "label": "編集",
                  "requires": "selection.Device"
                },
                "events": {
                  "click": [
                    {
                      "type": "openDialog",
                      "dialog": "deviceEdit",
                      "params": {
                        "deviceId": "{{ state.selection.Device?.id }}"
                      }
                    }
                  ]
                }
              },
              {
                "id": "toDashboard",
                "type": "Button",
                "props": {
                  "label": "ダッシュボードへ",
                  "variant": "secondary"
                },
                "events": {
                  "click": [
                    {
                      "type": "navigate",
                      "to": "dashboard"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "table",
            "type": "Table",
            "props": {
              "entity": "Device",
              "columns": [
                {
                  "header": "名前",
                  "value": "{{ row.name }}"
                },
                {
                  "header": "型番",
                  "value": "{{ row.model }}"
                },
                {
                  "header": "状態",
                  "value": "{{ row.status }}"
                },
                {
                  "header": "IP アドレス",
                  "value": "{{ row.ipAddress }}"
                }
              ],
              "rows": "{{ data.Device }}",
              "selectable": true
            },
            "events": {
              "rowClick": [
                {
                  "type": "navigate",
                  "to": "deviceDetail",
                  "params": {
                    "deviceId": "{{ event.row.id }}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "deviceDetail",
      "name": "機器詳細",
      "kind": "detail",
      "entity": "Device",
      "path": "/devices/:deviceId",
      "params": {
        "deviceId": {
          "type": "ref",
          "entity": "Device",
          "required": true
        }
      },
      "root": {
        "id": "page",
        "type": "Box",
        "props": {
          "direction": "column",
          "gap": 16
        },
        "children": [
          {
            "id": "title",
            "type": "Text",
            "props": {
              "text": "{{ record?.name }}",
              "variant": "title"
            }
          },
          {
            "id": "model",
            "type": "Text",
            "props": {
              "text": "型番: {{ record?.model }}"
            }
          },
          {
            "id": "status",
            "type": "Text",
            "props": {
              "text": "状態: {{ record?.status }}"
            }
          },
          {
            "id": "ipAddress",
            "type": "Text",
            "props": {
              "text": "IP アドレス: {{ record?.ipAddress }}"
            }
          },
          {
            "id": "alarmsTitle",
            "type": "Text",
            "props": {
              "text": "アラーム"
            }
          },
          {
            "id": "alarms",
            "type": "Table",
            "props": {
              "columns": [
                {
                  "header": "レベル",
                  "value": "{{ row.level }}"
                },
                {
                  "header": "内容",
                  "value": "{{ row.message }}"
                },
                {
                  "header": "確認済み",
                  "value": "{{ row.acknowledged }}"
                }
              ],
              "rows": "{{ record?.alarms ?? [] }}"
            }
          },
          {
            "id": "toolbar",
            "type": "Box",
            "props": {
              "direction": "row",
              "gap": 8
            },
            "children": [
              {
                "id": "delete",
                "type": "Button",
                "props": {
                  "label": "削除",
                  "variant": "danger"
                },
                "events": {
                  "click": [
                    {
                      "type": "openDialog",
                      "dialog": "deviceDelete",
                      "params": {
                        "deviceId": "{{ params.deviceId }}"
                      }
                    }
                  ]
                }
              },
              {
                "id": "back",
                "type": "Button",
                "props": {
                  "label": "一覧へ戻る",
                  "variant": "secondary"
                },
                "events": {
                  "click": [
                    {
                      "type": "navigate",
                      "to": "devices"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "dialogs": [
    {
      "id": "deviceEdit",
      "name": "機器の編集",
      "kind": "form",
      "entity": "Device",
      "params": {
        "deviceId": {
          "type": "ref",
          "entity": "Device",
          "required": true
        }
      },
      "root": {
        "id": "body",
        "type": "Box",
        "props": {
          "direction": "column",
          "gap": 12
        },
        "children": [
          {
            "id": "title",
            "type": "Text",
            "props": {
              "text": "機器の編集",
              "variant": "title"
            }
          },
          {
            "id": "name",
            "type": "TextInput",
            "props": {
              "value": "{{ draft.name }}",
              "error": "{{ errors.name }}",
              "label": "名前"
            },
            "events": {
              "change": [
                {
                  "type": "setDraft",
                  "field": "name",
                  "value": "{{ event.value }}"
                }
              ]
            }
          },
          {
            "id": "model",
            "type": "TextInput",
            "props": {
              "value": "{{ draft.model }}",
              "error": "{{ errors.model }}",
              "label": "型番"
            },
            "events": {
              "change": [
                {
                  "type": "setDraft",
                  "field": "model",
                  "value": "{{ event.value }}"
                }
              ]
            }
          },
          {
            "id": "status",
            "type": "Select",
            "props": {
              "value": "{{ draft.status }}",
              "error": "{{ errors.status }}",
              "label": "状態",
              "options": [
                {
                  "value": "online",
                  "label": "online"
                },
                {
                  "value": "offline",
                  "label": "offline"
                },
                {
                  "value": "warning",
                  "label": "warning"
                }
              ]
            },
            "events": {
              "change": [
                {
                  "type": "setDraft",
                  "field": "status",
                  "value": "{{ event.value }}"
                }
              ]
            }
          },
          {
            "id": "ipAddress",
            "type": "TextInput",
            "props": {
              "value": "{{ draft.ipAddress }}",
              "error": "{{ errors.ipAddress }}",
              "label": "IP アドレス"
            },
            "events": {
              "change": [
                {
                  "type": "setDraft",
                  "field": "ipAddress",
                  "value": "{{ event.value }}"
                }
              ]
            }
          },
          {
            "id": "actions",
            "type": "Box",
            "props": {
              "direction": "row",
              "gap": 8
            },
            "children": [
              {
                "id": "save",
                "type": "Button",
                "props": {
                  "label": "保存",
                  "variant": "primary"
                },
                "events": {
                  "click": [
                    {
                      "type": "saveDraft"
                    },
                    {
                      "type": "closeDialog",
                      "result": "ok"
                    }
                  ]
                }
              },
              {
                "id": "cancel",
                "type": "Button",
                "props": {
                  "label": "キャンセル",
                  "variant": "secondary"
                },
                "events": {
                  "click": [
                    {
                      "type": "closeDialog",
                      "result": "cancel"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "deviceDelete",
      "name": "削除の確認",
      "kind": "confirm",
      "entity": "Device",
      "params": {
        "deviceId": {
          "type": "ref",
          "entity": "Device",
          "required": true
        }
      },
      "root": {
        "id": "body",
        "type": "Box",
        "props": {
          "direction": "column",
          "gap": 12
        },
        "children": [
          {
            "id": "message",
            "type": "Text",
            "props": {
              "text": "「{{ record?.name }}」を削除しますか？設定・メトリクス・アラームも削除されます。"
            }
          },
          {
            "id": "actions",
            "type": "Box",
            "props": {
              "direction": "row",
              "gap": 8
            },
            "children": [
              {
                "id": "ok",
                "type": "Button",
                "props": {
                  "label": "削除する",
                  "variant": "danger"
                },
                "events": {
                  "click": [
                    {
                      "type": "deleteRecord",
                      "entity": "Device",
                      "match": {
                        "id": "{{ params.deviceId }}"
                      }
                    },
                    {
                      "type": "closeDialog",
                      "result": "ok"
                    },
                    {
                      "type": "navigate",
                      "to": "devices"
                    }
                  ]
                }
              },
              {
                "id": "cancel",
                "type": "Button",
                "props": {
                  "label": "キャンセル",
                  "variant": "secondary"
                },
                "events": {
                  "click": [
                    {
                      "type": "closeDialog",
                      "result": "cancel"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
